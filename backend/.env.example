# SIH V3 Weather Nowcasting Backend Environment Settings
MODEL_PATH=./models/sih_v3_best.pth
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
HOST=0.0.0.0
PORT=8000

# Atmospheric Data Provider Mode ('synthetic' | 'operational')
DATA_PROVIDER=synthetic

# Operational Data Ingestion Sources (Phase 1)
# NOAA GFS / Open-Meteo Operational Seamless NWP API
GFS_OPERATIONAL_API=https://api.open-meteo.com/v1

# AWS Open Data Public Satellite Bucket (Himawari-9 AHI Band 13)
# No AWS credentials required (Public Open Data Registry)
HIMAWARI_S3_BUCKET=noaa-himawari9

