# WeatherNow AI — Environment Variables
# Copy this file to .env and configure for your environment

# Backend API base URL (ML model / nowcasting backend)
VITE_API_BASE_URL=http://localhost:8000/api

# Optional: Data refresh interval in seconds (default: 60)
VITE_REFRESH_INTERVAL=60

# Optional: Default location (matches LOCATIONS array id in mockData)
VITE_DEFAULT_LOCATION=dehradun
